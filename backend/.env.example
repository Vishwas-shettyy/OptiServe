# OptiServe v2 backend settings. Copy to backend/.env and fill in. Never commit .env.

# Database: SQLite by default; set a postgresql:// URL to use Postgres.
DATABASE_URL=sqlite:///./optiserve.db

# Auth: single admin login. Generate the hash with backend/scripts/hash_password.py.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# AWS: keys come from the environment or an IAM role, never from this file's DB.
AWS_REGION=ap-south-1

# Live mode shortens analysis windows for live demos (real data, shorter windows).
LIVE_MODE=false

# Dry run logs what would happen instead of changing infrastructure.
DRY_RUN=true

# Risk: 0 = save cost (servers up to 85% busy), 1 = stay safe (55%). 0.5 → 70%.
RISK=0.5

# Run background jobs (sync, engine, verification) inside the API process.
SCHEDULER_ENABLED=true

# USD to INR conversion rate for cost and savings figures.
USD_INR=83.0

# CORS: the only origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
# Max /api/ingest requests per agent token per minute (the agent sends 6/min)
INGEST_RATE_LIMIT_PER_MIN=30
