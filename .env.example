# OptiServe settings for docker compose. Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# For local development without Docker, use backend/.env instead (same keys, see backend/.env.example).

# --- Login (required) ---
# A long random string, e.g. from: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# Hash from: docker compose run --rm backend python scripts/hash_password.py
# Keep the single quotes: the hash contains '$' signs.
ADMIN_PASSWORD_HASH=''

# The address people open OptiServe at (CORS; https:// also makes the login cookie secure-only).
FRONTEND_ORIGIN=http://localhost

# Port on the host for the web app (nginx). Agents use the same address: http://<host>:<port>
HTTP_PORT=80

# --- How OptiServe acts (can also be changed later in Settings) ---
LIVE_MODE=false
DRY_RUN=true
RISK=0.5

# --- AWS ---
# On EC2 with an IAM role, leave keys out. Otherwise set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
AWS_REGION=ap-south-1

USD_INR=83.0
SCHEDULER_ENABLED=true
INGEST_RATE_LIMIT_PER_MIN=30

# --- Database ---
# Default: SQLite on the optiserve-data volume (nothing to set).
# Postgres (run with --profile postgres):
# POSTGRES_PASSWORD=choose-a-long-password
# DATABASE_URL=postgresql+psycopg://optiserve:choose-a-long-password@postgres:5432/optiserve
